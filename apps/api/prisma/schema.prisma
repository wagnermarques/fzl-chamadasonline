generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
}

model User {
  id                 String   @id @default(uuid())
  role               Role
  registrationNumber String?  @unique
  email              String?  @unique
  name               String
  pinHash            String
  createdAt          DateTime @default(now())

  devices                Device[]
  checkins               Checkin[]
  enrollmentCodesOwned   DeviceEnrollmentCode[] @relation("EnrollmentCodeStudent")
  enrollmentCodesIssued  DeviceEnrollmentCode[] @relation("EnrollmentCodeStaff")
  devicesVerified        Device[]               @relation("DeviceVerifiedByStaff")

  @@index([role])
}

model Event {
  id                   String   @id @default(uuid())
  name                 String
  date                 DateTime
  geofenceLat          Float
  geofenceLng          Float
  geofenceRadiusMeters Float    @default(150)
  // Optional precise boundary of the school grounds: an array of
  // {lat, lng} points, at least 3, entered by staff as a coordinate list.
  // When present, this takes priority over the circle above.
  geofencePolygon      Json?
  createdAt            DateTime @default(now())

  periods EventPeriod[]
}

model EventPeriod {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  label     String
  startsAt  DateTime
  endsAt    DateTime

  codes    CheckinCode[]
  checkins Checkin[]

  @@index([eventId])
}

model CheckinCode {
  id            String      @id @default(uuid())
  eventPeriodId String
  eventPeriod   EventPeriod @relation(fields: [eventPeriodId], references: [id])
  code          String
  issuedAt      DateTime    @default(now())
  expiresAt     DateTime

  @@index([eventPeriodId, expiresAt])
}

model Device {
  id              String    @id @default(uuid())
  clientToken     String    @unique
  studentId       String?
  student         User?     @relation(fields: [studentId], references: [id])
  fingerprintHash String?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @updatedAt

  // Set only through the staff-supervised enrollment flow (secretaria).
  // Distinct from the soft `studentId` binding above (first-login, never
  // verified by a human) — a verified device is the one that can actually
  // check in for that student once one exists.
  verified         Boolean  @default(false)
  verifiedAt       DateTime?
  verifiedByStaffId String?
  verifiedByStaff   User?   @relation("DeviceVerifiedByStaff", fields: [verifiedByStaffId], references: [id])

  checkins Checkin[]

  @@index([fingerprintHash])
  @@index([studentId, verified])
}

model DeviceEnrollmentCode {
  id              String   @id @default(uuid())
  studentId       String
  student         User     @relation("EnrollmentCodeStudent", fields: [studentId], references: [id])
  code            String
  issuedByStaffId String
  issuedByStaff   User     @relation("EnrollmentCodeStaff", fields: [issuedByStaffId], references: [id])
  issuedAt        DateTime @default(now())
  expiresAt       DateTime
  usedAt          DateTime?

  @@index([studentId, expiresAt])
}

model Checkin {
  id             String      @id @default(uuid())
  studentId      String
  student        User        @relation(fields: [studentId], references: [id])
  eventPeriodId  String
  eventPeriod    EventPeriod @relation(fields: [eventPeriodId], references: [id])
  deviceId       String
  device         Device      @relation(fields: [deviceId], references: [id])
  lat            Float
  lng            Float
  distanceMeters Float
  flagged        Boolean     @default(false)
  flagReasons    String[]    @default([])
  reviewed       Boolean     @default(false)
  reviewDecision String?
  createdAt      DateTime    @default(now())

  @@unique([studentId, eventPeriodId])
  @@index([eventPeriodId])
  @@index([flagged])
}
