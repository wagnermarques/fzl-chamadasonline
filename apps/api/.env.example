# Local docker-compose Postgres by default. For Supabase, use the "Connection
# pooling" URI from Settings -> Database -> Connection string (port 6543).
DATABASE_URL="postgresql://chamadas:chamadas@localhost:5432/chamadasonline"

JWT_SECRET="change-me-in-production"
PORT=3333

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS="http://localhost:5173,https://your-username.github.io"

# --- Supabase (optional, unused by current code paths) ---
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""
