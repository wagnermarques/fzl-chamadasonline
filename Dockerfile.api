FROM node:22-alpine

WORKDIR /app

# Copy root workspace package files
COPY package.json package-lock.json ./

# Copy individual workspace package files to preserve structure
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Install dependencies for all workspaces
RUN npm ci

# Copy the actual source code we need for the backend
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

# Generate Prisma Client
RUN npm run prisma:generate --workspace apps/api || npx prisma generate --schema apps/api/prisma/schema.prisma

# Build the shared package and the API
RUN npm run build --workspace packages/shared --if-present
RUN npm run build --workspace apps/api

EXPOSE 3333

ENV NODE_ENV=production

CMD ["npm", "run", "start", "--workspace", "apps/api"]
